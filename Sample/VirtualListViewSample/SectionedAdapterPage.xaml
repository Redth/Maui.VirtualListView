<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	x:Class="VirtualListViewSample.SectionedAdapterPage"
	xmlns:local="clr-namespace:VirtualListViewSample"
	xmlns:vlv="clr-namespace:Microsoft.Maui.Controls;assembly=VirtualListView"
	Title="SectionedAdapterPage">
	<Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,*,Auto" Padding="20">
		<Grid Grid.ColumnSpan="3" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="8">
			<Button Text="Refresh" Clicked="RequestRefresh_Clicked" AutomationId="request-refresh" />
			<HorizontalStackLayout Grid.Column="1" Spacing="8">
				<Label Text="Refresh enabled" VerticalOptions="Center" />
				<Switch x:Name="refreshEnabled" IsToggled="True" AutomationId="refresh-enabled" />
			</HorizontalStackLayout>
			<Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
				<Button Text="Full" Clicked="FullContent_Clicked" AutomationId="refresh-full" />
				<Button Grid.Column="1" Text="Short" Clicked="ShortContent_Clicked" AutomationId="refresh-short" />
				<Button Grid.Column="2" Text="Empty" Clicked="EmptyContent_Clicked" AutomationId="refresh-empty" />
				<Button Grid.Column="3" Text="End" Clicked="ScrollEnd_Clicked" AutomationId="refresh-scroll-end" />
			</Grid>
			<Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
				<Label Text="Horizontal" VerticalOptions="Center" />
				<Switch Grid.Column="1" Toggled="Horizontal_Toggled" AutomationId="refresh-horizontal" />
				<Label x:Name="refreshStatus" Grid.Column="2" VerticalOptions="Center"
					Text="No refresh requests started" AutomationId="refresh-status" />
			</Grid>
		</Grid>
		<vlv:VirtualListView
			Grid.Row="1"
			Grid.Column="0" Grid.ColumnSpan="3"
			IsRefreshEnabled="{Binding Source={x:Reference refreshEnabled}, Path=IsToggled}"
			OnRefresh="Vlv_OnOnRefresh"
			x:Name="vlv"
			OnSelectedItemsChanged="vlv_SelectedItemsChanged"
			SelectionMode="Single">
			<vlv:VirtualListView.EmptyView>
				<Label Text="Empty!" BackgroundColor="{AppThemeBinding Light=White, Dark=Black}"
					HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
			</vlv:VirtualListView.EmptyView>
			<vlv:VirtualListView.SectionHeaderTemplate>
				<DataTemplate>
					<Border
						Padding="4"
						Background="DarkBlue"
						StrokeShape="{RoundRectangle CornerRadius=10}">
						<Label Margin="10,6,10,6" Text="{Binding Title}" TextColor="White" />
					</Border>
				</DataTemplate>
			</vlv:VirtualListView.SectionHeaderTemplate>
			<vlv:VirtualListView.ItemTemplate>
				<DataTemplate>
					<Border
					Margin="10,0,0,0"
					Padding="4"
					Background="LightBlue"
					StrokeShape="{RoundRectangle CornerRadius=10}">
						<Label Margin="10,6,10,6" Text="{Binding .}" />
					</Border>
				</DataTemplate>
			</vlv:VirtualListView.ItemTemplate>
		</vlv:VirtualListView>

		<Entry x:Name="entrySection" Grid.Row="2" Grid.Column="0" Placeholder="Section" />
		<Entry x:Name="entryItem" Grid.Row="2" Grid.Column="1" Placeholder="Item" />
		<Button Grid.Row="2" Grid.Column="2" Text="Add" Clicked="Button_Clicked" />
	</Grid>
</ContentPage>